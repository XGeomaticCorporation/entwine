{
  "name": "entwine",
  "description": "Entwine - point cloud organization for massive datasets",
  "homepage": "https://entwine.io/",
  "supports": "(linux | windows | osx) & (x86 | x64 | arm64)",
  "builtin-baseline": "ee2d2a100103e0f3613c60655dcf15be7d5157b8",
  "dependencies": [
    "gflags",
    "glog",
    {
      "name": "spdlog",
      "features": [ "wchar" ]
    },
    "nanoflann",
    "pdal",
    {
      "name": "gdal",
      "features": [ "tools" ]
    },
    "nlohmann-json",
    "openssl",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "tests": {
      "description": "Build all tests.",
      "dependencies": [
        "gtest"
      ]
    }
  }
}
